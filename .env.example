# Variables de entorno OPCIONALES. Taskflow no lee este archivo: si las necesitas,
# expórtalas en tu terminal o en CI. Tienen precedencia sobre el llavero del sistema (§13.4).
#
# Lo normal es no usar ninguna: `taskflow config init` guarda el token en el llavero y el
# resto de la configuración en config.toml (`taskflow config path` dice dónde).
TASKFLOW_CLICKUP_TOKEN=
TASKFLOW_ANTHROPIC_API_KEY=
